# Vite uses .env.production automatically during `npm run build`
# All VITE_* vars are baked into the bundle at build time.
# ─────────────────────────────────────────────────────────────────────────────

VITE_FIREBASE_API_KEY=AIzaSyAVtWy0m9skmF5_UlJEo9zt8pdATljhfEY
VITE_FIREBASE_AUTH_DOMAIN=xz-digital-roots-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=xz-digital-roots-project
VITE_FIREBASE_STORAGE_BUCKET=xz-digital-roots-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=1073882360457
VITE_FIREBASE_APP_ID=1:1073882360457:web:1aa63110353e745b89f458
VITE_FIREBASE_MEASUREMENT_ID=G-05N71TT558

# All backend requests go through Nginx proxy on the same HTTPS domain.
# Nginx routes /api → localhost:8000 and /socket.io → localhost:8000
# This avoids all Mixed Content errors (no more http:// calls from an https:// page).
VITE_BACKEND_URL=https://xz-digitalroots.duckdns.org
VITE_USER_SERVICE_URL=https://xz-digitalroots.duckdns.org
VITE_NOTIFICATION_SERVICE_URL=https://xz-digitalroots.duckdns.org
VITE_CONTENT_URL=https://xz-digitalroots.duckdns.org
VITE_FEED_SERVICE_URL=https://xz-digitalroots.duckdns.org
